<?xml version="1.0" encoding="UTF-8"?><jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EndosoNotaCredito" pageWidth="842" pageHeight="595" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail"><parameter name="id" class="java.lang.Long"/><parameter name="cuenta" class="java.lang.Long"/><parameter name="estado" class="java.lang.String"/><parameter name="desde" class="java.sql.Date"/><parameter name="hasta" class="java.sql.Date"/><queryString><![CDATA[SELECT e.id,e.nota_origen_id,e.estado,e.cuenta_origen,e.monto_total,e.documento_respaldo,e.referencia,e.motivo,
e.solicitante_id,e.autorizador_id,e.ejecutor_id,e.creado_en,e.fecha_ejecucion,e.saldo_antes,e.saldo_despues,
e.huella,d.cuenta_destino,d.monto,d.nota_derivada_id,co.nombre origen_titular,cd.nombre destino_titular
FROM nc_endoso e JOIN nc_endoso_detalle d ON d.endoso_id=e.id
JOIN abonados ao ON ao.idabonado=e.cuenta_origen JOIN clientes co ON co.idcliente=ao.idresponsable
JOIN abonados ad ON ad.idabonado=d.cuenta_destino JOIN clientes cd ON cd.idcliente=ad.idresponsable
WHERE ($P{id} IS NULL OR e.id=$P{id}) AND ($P{estado} IS NULL OR e.estado=$P{estado})
AND ($P{cuenta} IS NULL OR e.cuenta_origen=$P{cuenta} OR EXISTS(SELECT 1 FROM nc_endoso_detalle filtro WHERE filtro.endoso_id=e.id AND filtro.cuenta_destino=$P{cuenta}))
AND ($P{desde} IS NULL OR e.creado_en>=cast($P{desde} as date))
AND ($P{hasta} IS NULL OR e.creado_en<cast($P{hasta} as date)+interval '1 day') ORDER BY e.id,d.cuenta_destino]]></queryString><field name="id" class="java.lang.Long"/><field name="nota_origen_id" class="java.lang.Long"/><field name="estado" class="java.lang.String"/><field name="cuenta_origen" class="java.lang.Long"/><field name="monto_total" class="java.math.BigDecimal"/><field name="documento_respaldo" class="java.lang.String"/><field name="referencia" class="java.lang.String"/><field name="motivo" class="java.lang.String"/><field name="solicitante_id" class="java.lang.Short"/><field name="autorizador_id" class="java.lang.Short"/><field name="ejecutor_id" class="java.lang.Short"/><field name="creado_en" class="java.sql.Timestamp"/><field name="fecha_ejecucion" class="java.sql.Timestamp"/><field name="saldo_antes" class="java.math.BigDecimal"/><field name="saldo_despues" class="java.math.BigDecimal"/><field name="huella" class="java.lang.String"/><field name="cuenta_destino" class="java.lang.Long"/><field name="monto" class="java.math.BigDecimal"/><field name="nota_derivada_id" class="java.lang.Long"/><field name="origen_titular" class="java.lang.String"/><field name="destino_titular" class="java.lang.String"/><group name="Endoso"><groupExpression><![CDATA[$F{id}]]></groupExpression><groupHeader><band height="116"><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="802" height="16"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["ENDOSO #"+$F{id}+" | "+$F{estado}+" | Nota origen #"+$F{nota_origen_id}+" | Cuenta: "+$F{cuenta_origen}+" - "+$F{origen_titular}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="18" width="802" height="16"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Respaldo: "+$F{documento_respaldo}+" | Referencia: "+$F{referencia}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="36" width="802" height="16"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Solicita: "+$F{solicitante_id}+" | Autoriza: "+$F{autorizador_id}+" | Ejecuta: "+$F{ejecutor_id}+" | Fecha: "+$F{fecha_ejecucion}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="54" width="802" height="16"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Total endoso: "+$F{monto_total}+" | Saldo origen antes: "+$F{saldo_antes}+" | Despues: "+$F{saldo_despues}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="72" width="802" height="22"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Motivo: "+$F{motivo}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="96" width="802" height="16"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Cuenta destino / Titular / Importe recibido / Nota derivada"]]></textFieldExpression></textField></band></groupHeader><groupFooter><band height="20"><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="802" height="18"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["Trazabilidad: "+$F{huella}]]></textFieldExpression></textField></band></groupFooter></group><title><band height="32"><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="802" height="30"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA["EPMAPA-T - ENDOSOS DE SALDO A FAVOR | Documento interno, no comprobante tributario SRI"]]></textFieldExpression></textField></band></title><detail><band height="20"><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="110" height="20"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{cuenta_destino}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="110" y="0" width="402" height="20"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{destino_titular}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="512" y="0" width="130" height="20"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{monto}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="642" y="0" width="160" height="20"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{nota_derivada_id}]]></textFieldExpression></textField></band></detail></jasperReport>