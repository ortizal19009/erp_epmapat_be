	<subDataset name="Usuario" uuid="f8fd497c-0b94-4617-b33a-85c9a2acf36b">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ErpEpmapaT"/>
		<parameter name="idusuario" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT nomusu
FROM usuarios
WHERE 
	 usuarios.idusuario =  $P{idusuario}]]>
		</queryString>
		<field name="nomusu" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nomusu"/>
			<property name="com.jaspersoft.studio.field.label" value="nomusu"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="usuarios"/>
		</field>
	</subDataset>
	<subDataset name="DetallesRubros" uuid="42f6dbcb-ce49-414b-a427-875f5ef2f900">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Erp_epmapat"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="idemision" class="java.lang.Integer"/>
		<parameter name="ORACLE_REF_CURSOR" class="interface java.sql.ResultSet" isForPrompting="false"/>
		<queryString language="plsql">
			<![CDATA[select
    r.descripcion as rubro, 
    CEIL(sum(rf.valorunitario * rf.cantidad) * 100) / 100 as valor, 
    count(l.idabonado_abonados) as numabonados
from
    lecturas l
join rubroxfac rf on
    l.idfactura = rf.idfactura_facturas
join rubros r on
    rf.idrubro_rubros = r.idrubro
where
    idemision =  $P{idemision} 
    and rf.idrubro_rubros not in (5,165)
group by 
    r.descripcion]]>
		</queryString>
		<field name="rubro" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="rubro"/>
			<property name="com.jaspersoft.studio.field.label" value="rubro"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="rubros"/>
		</field>
		<field name="valor" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="valor"/>
			<property name="com.jaspersoft.studio.field.label" value="valor"/>
		</field>
		<field name="numabonados" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="numabonados"/>
			<property name="com.jaspersoft.studio.field.label" value="numabonados"/>
		</field>
		<variable name="sumaRubros" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{valor}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="DetallesCategorias" uuid="bbd27ba7-eadd-400e-ae64-f96a49128888">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SERVIDOR EPMAPAT"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="idemision" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[SELECT
    CASE
        WHEN c.idcategoria = 9 AND a.adultomayor = true THEN 'ADULTO MAYOR'
        WHEN c.idcategoria = 9 AND a.adultomayor = false THEN 'DISCAPACITADO'
        WHEN c.idcategoria = 4 AND a.municipio = true THEN 'MUNICIPAL'
        WHEN c.idcategoria = 4 AND a.municipio = false THEN 'NO MUNICIPAL'
        ELSE c.descripcion
    END AS categoria,

    ROUND(SUM((rf.valorunitario * rf.cantidad)::numeric), 2) AS valor,

    COUNT(l.idabonado_abonados) AS numabonados

FROM lecturas l
JOIN rubroxfac rf ON l.idfactura = rf.idfactura_facturas
JOIN categorias c ON l.idcategoria = c.idcategoria 
JOIN abonados a ON l.idabonado_abonados = a.idabonado 

WHERE
    l.idemision =  $P{idemision} 
    AND rf.idrubro_rubros NOT IN (5,165)

GROUP BY
    CASE
        WHEN c.idcategoria = 9 AND a.adultomayor = true THEN 'ADULTO MAYOR'
        WHEN c.idcategoria = 9 AND a.adultomayor = false THEN 'DISCAPACITADO'
        WHEN c.idcategoria = 4 AND a.municipio = true THEN 'MUNICIPAL'
        WHEN c.idcategoria = 4 AND a.municipio = false THEN 'NO MUNICIPAL'
        ELSE c.descripcion
    END;]]>
		</queryString>
		<field name="categoria" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="categoria"/>
			<property name="com.jaspersoft.studio.field.label" value="categoria"/>
		</field>
		<field name="valor" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="valor"/>
			<property name="com.jaspersoft.studio.field.label" value="valor"/>
		</field>
		<field name="numabonados" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="numabonados"/>
			<property name="com.jaspersoft.studio.field.label" value="numabonados"/>
		</field>
		<variable name="sumaTotal" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{valor}]]></variableExpression>
		</variable>
	</subDataset>
