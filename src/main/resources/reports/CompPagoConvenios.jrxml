	<parameter name="idfactura" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[select
	f.nrofactura,
	f.idfactura,
	c.nombre,
	c.cedula,
	c.direccion,
	u.nomusu,
	m.descripcion as modulo,
	f.fechacobro

, (
  SELECT COUNT(*)
  FROM rubroxfac rf
  JOIN rubros r ON rf.idrubro_rubros = r.idrubro
  WHERE rf.idfactura_facturas = $P{idfactura} AND (rf.estado IS NULL OR rf.estado <> 0)
    AND r.ajenos = true
    AND rf.idrubro_rubros NOT IN (165, 5)
) AS cnt_ajenos
from
	 facturas f
join clientes c on
	f.idcliente = c.idcliente
join usuarios u on
	f.usuariocobro = u.idusuario
join modulos m on
	f.idmodulo = m.idmodulo
where
	f.idfactura= $P{idfactura}]]>
	</queryString>
