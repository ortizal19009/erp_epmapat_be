	<subDataset name="DetallesFactura" uuid="25e7cfb9-414f-486c-953b-ebd40ba49c33">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ErpEpmapaT"/>
		<parameter name="idfactura" class="java.lang.Long"/>
		<queryString language="SQL">
			<![CDATA[SELECT r.descripcion,
	rf.cantidad,
	rf.valorunitario,
	rf.cantidad * rf.valorunitario AS total
FROM rubroxfac rf
	join rubros r ON 
	 rf.idrubro_rubros = r.idrubro 
WHERE 
	 rf.idfactura_facturas = $P{idfactura} and (rf.estado IS NULL OR rf.estado <> 0) and r.ajenos = false
	 AND NOT  ( 
	 rf.idrubro_rubros = 165 
	 OR rf.idrubro_rubros = 5)]]>
		</queryString>
		<field name="descripcion" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="descripcion"/>
			<property name="com.jaspersoft.studio.field.label" value="descripcion"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="rubros"/>
		</field>
		<field name="cantidad" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="cantidad"/>
			<property name="com.jaspersoft.studio.field.label" value="cantidad"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="rubroxfac"/>
		</field>
		<field name="valorunitario" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="valorunitario"/>
			<property name="com.jaspersoft.studio.field.label" value="valorunitario"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="rubroxfac"/>
		</field>
		<field name="total" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="total"/>
			<property name="com.jaspersoft.studio.field.label" value="total"/>
		</field>
		<group name="descripcion">
			<groupExpression><![CDATA[$F{descripcion}]]></groupExpression>
		</group>
		<group name="cantidad">
			<groupExpression><![CDATA[$F{cantidad}]]></groupExpression>
		</group>
		<group name="valorunitario">
			<groupExpression><![CDATA[$F{valorunitario}]]></groupExpression>
		</group>
		<group name="total">
			<groupExpression><![CDATA[$F{total}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="FacturaTotales" uuid="4cdfb0b5-5c2d-48be-bf5d-dd1a1cf954c8">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ErpEpmapaT"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="idfactura" class="java.lang.Long"/>
		<queryString>
			<![CDATA[SELECT 
    rf.idfactura_facturas,
    SUM(rf.cantidad * rf.valorunitario)  AS subtotal,
    COALESCE(f.swiva, 0) AS iva,
    COALESCE(f.interescobrado, 0) AS interes, 
      COALESCE( f.valornotacredito, 0) as nc,
    SUM(rf.cantidad * rf.valorunitario) + COALESCE(f.swiva, 0) + COALESCE(f.interescobrado, 0)  AS total
FROM facturas f
JOIN rubroxfac rf ON f.idfactura = rf.idfactura_facturas 
JOIN rubros r ON r.idrubro = rf.idrubro_rubros 
WHERE (rf.estado IS NULL OR rf.estado <> 0) AND rf.idrubro_rubros NOT IN (165, 5)
  AND f.idfactura = $P{idfactura}
GROUP BY rf.idfactura_facturas, f.swiva, f.interescobrado, f.valornotacredito]]>
		</queryString>
		<field name="idfactura_facturas" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="idfactura_facturas"/>
			<property name="com.jaspersoft.studio.field.label" value="idfactura_facturas"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="rubroxfac"/>
		</field>
		<field name="subtotal" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="subtotal"/>
			<property name="com.jaspersoft.studio.field.label" value="subtotal"/>
		</field>
		<field name="iva" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="iva"/>
			<property name="com.jaspersoft.studio.field.label" value="iva"/>
		</field>
		<field name="interes" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="interes"/>
			<property name="com.jaspersoft.studio.field.label" value="interes"/>
		</field>
		<field name="nc" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="nc"/>
			<property name="com.jaspersoft.studio.field.label" value="nc"/>
		</field>
		<field name="total" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="total"/>
			<property name="com.jaspersoft.studio.field.label" value="total"/>
		</field>
	</subDataset>
	<subDataset name="HistorialConsumo" uuid="d9d002d4-d5d1-4879-a6fb-864a91b89472">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ErpEpmapaT"/>
		<parameter name="cuenta" class="java.lang.Long"/>
		<queryString language="SQL">
			<![CDATA[SELECT 
    e.emision,
    l.lecturaactual - l.lecturaanterior AS m3
FROM lecturas l
JOIN emisiones e ON l.idemision = e.idemision 
WHERE 
    l.idabonado_abonados = $P{cuenta} AND l.observaciones IS NULL
    AND (l.lecturaactual - l.lecturaanterior) >= 0
ORDER BY l.idemision DESC
LIMIT 8]]>
		</queryString>
		<field name="emision" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="emision"/>
			<property name="com.jaspersoft.studio.field.label" value="emision"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="emisiones"/>
		</field>
		<field name="m3" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="m3"/>
			<property name="com.jaspersoft.studio.field.label" value="m3"/>
		</field>
		<group name="emision">
			<groupExpression><![CDATA[$F{emision}]]></groupExpression>
		</group>
		<group name="m3">
			<groupExpression><![CDATA[$F{m3}]]></groupExpression>
		</group>
	</subDataset>
