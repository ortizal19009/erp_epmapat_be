<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.21.5.final using JasperReports Library version 6.21.5-74d586df47b25dbd05bd0957999819196e59934a  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EmisionFinal" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="25" uuid="9e90306b-f891-40fc-b0ad-f55d9c46e03b">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SERVIDOR EPMAPAT"/>
	<parameter name="idemision" class="java.lang.Long"/>
	<parameter name="idusuario" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[WITH fecha_inicial AS (
 SELECT l.fechaemision FROM lecturas l WHERE l.idemision = $P{idemision}
 GROUP BY l.fechaemision ORDER BY COUNT(*) DESC, l.fechaemision ASC LIMIT 1
), datos AS (
 SELECT 1 orden, 'EMISION INICIAL' seccion, rf.idrubro_rubros id_rubro, r.descripcion, COUNT(DISTINCT l.idabonado_abonados) abonados, SUM(ROUND(CAST(rf.cantidad * rf.valorunitario AS numeric), 2)) valor, NULL::bigint cuenta, NULL::text nombre, NULL::text cedula, NULL::text direccion, NULL::bigint idfactura, NULL::date fechaeliminacion
 FROM lecturas l JOIN rubroxfac rf ON rf.idfactura_facturas = l.idfactura AND (rf.estado IS NULL OR rf.estado <> 0) JOIN rubros r ON r.idrubro = rf.idrubro_rubros
 WHERE l.idemision = $P{idemision} AND l.fechaemision = (SELECT fechaemision FROM fecha_inicial) AND rf.idrubro_rubros <> 5 GROUP BY rf.idrubro_rubros, r.descripcion
 UNION ALL
 SELECT 2, 'EMISIONES ELIMINADAS', rf.idrubro_rubros, r.descripcion, COUNT(DISTINCT l.idabonado_abonados), SUM(ROUND(CAST(rf.cantidad * rf.valorunitario AS numeric), 2)), NULL::bigint, NULL::text, NULL::text, NULL::text, NULL::bigint, NULL::date
 FROM lecturas l JOIN facturas f ON f.idfactura = l.idfactura JOIN rubroxfac rf ON rf.idfactura_facturas = l.idfactura AND (rf.estado IS NULL OR rf.estado <> 0) JOIN rubros r ON r.idrubro = rf.idrubro_rubros
 WHERE l.idemision = $P{idemision} AND f.fechaeliminacion IS NOT NULL AND rf.idrubro_rubros <> 5 GROUP BY rf.idrubro_rubros, r.descripcion
 UNION ALL
 SELECT 3, 'EMISIONES NUEVAS', rf.idrubro_rubros, r.descripcion, COUNT(DISTINCT l.idabonado_abonados), SUM(ROUND(CAST(rf.cantidad * rf.valorunitario AS numeric), 2)), NULL::bigint, NULL::text, NULL::text, NULL::text, NULL::bigint, NULL::date
 FROM emisionindividual ei JOIN lecturas l ON l.idlectura = ei.idlecturanueva JOIN facturas f ON f.idfactura = l.idfactura JOIN rubroxfac rf ON rf.idfactura_facturas = l.idfactura AND (rf.estado IS NULL OR rf.estado <> 0) JOIN rubros r ON r.idrubro = rf.idrubro_rubros
 WHERE ei.idemision = $P{idemision} AND f.fechaeliminacion IS NULL AND rf.idrubro_rubros <> 5 GROUP BY rf.idrubro_rubros, r.descripcion
 UNION ALL
 SELECT 4, 'EMISION FINAL', rf.idrubro_rubros, r.descripcion, COUNT(DISTINCT l.idabonado_abonados), SUM(ROUND(CAST(rf.cantidad * rf.valorunitario AS numeric), 2)), NULL::bigint, NULL::text, NULL::text, NULL::text, NULL::bigint, NULL::date
 FROM lecturas l JOIN facturas f ON f.idfactura = l.idfactura JOIN rubroxfac rf ON rf.idfactura_facturas = l.idfactura AND (rf.estado IS NULL OR rf.estado <> 0) JOIN rubros r ON r.idrubro = rf.idrubro_rubros
 WHERE l.idemision = $P{idemision} AND f.fechaeliminacion IS NULL AND rf.idrubro_rubros <> 5 GROUP BY rf.idrubro_rubros, r.descripcion
 UNION ALL
 SELECT 5, 'FACTURAS ELIMINADAS - DETALLE', NULL::bigint, NULL::text, NULL::bigint, COALESCE(SUM(ROUND(CAST(rf.cantidad * rf.valorunitario AS numeric), 2)), 0), a.idabonado, c.nombre, c.cedula, a.direccionubicacion, f.idfactura, f.fechaeliminacion
 FROM lecturas l JOIN facturas f ON f.idfactura = l.idfactura LEFT JOIN abonados a ON a.idabonado = l.idabonado_abonados LEFT JOIN clientes c ON c.idcliente = a.idcliente_clientes LEFT JOIN rubroxfac rf ON rf.idfactura_facturas = l.idfactura AND (rf.estado IS NULL OR rf.estado <> 0)
 WHERE l.idemision = $P{idemision} AND f.fechaeliminacion IS NOT NULL GROUP BY f.idfactura, f.nrofactura, f.fechaeliminacion, a.idabonado, c.nombre, c.cedula, a.direccionubicacion
 UNION ALL
 SELECT 6, 'NUEVAS FACTURAS CREADAS - DETALLE', NULL::bigint, NULL::text, NULL::bigint, SUM(ROUND(CAST(rf.cantidad * rf.valorunitario AS numeric), 2)), a.idabonado, c.nombre, c.cedula, a.direccionubicacion, f.idfactura, NULL::date
 FROM emisionindividual ei JOIN lecturas l ON l.idlectura = ei.idlecturanueva JOIN facturas f ON f.idfactura = l.idfactura JOIN abonados a ON a.idabonado = l.idabonado_abonados JOIN clientes c ON c.idcliente = a.idcliente_clientes JOIN rubroxfac rf ON rf.idfactura_facturas = l.idfactura AND (rf.estado IS NULL OR rf.estado <> 0)
 WHERE ei.idemision = $P{idemision} AND f.fechaeliminacion IS NULL GROUP BY f.idfactura, f.nrofactura, a.idabonado, c.nombre, c.cedula, a.direccionubicacion
) SELECT datos.*, (SELECT u.nomusu FROM usuarios u WHERE u.idusuario = $P{idusuario}) AS usuario_impresion
  FROM datos
  ORDER BY orden, descripcion NULLS LAST, cuenta, idfactura]]>
	</queryString>
