<!-- Created with Jaspersoft Studio version 6.21.5.final using JasperReports Library version 6.21.5-74d586df47b25dbd05bd0957999819196e59934a  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ConteoFacturacionPorFormaPago" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" uuid="7f8f5872-16c0-4c7d-b78a-cabd0684b1fe">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SERVIDOR EPMAPAT"/>
	<parameter name="desde" class="java.sql.Date"/>
	<parameter name="hasta" class="java.sql.Date"/>
	<parameter name="idusuario" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[WITH limites AS (
 SELECT CAST($P{desde} AS date) AS inicio,
        CAST($P{hasta} AS date) + INTERVAL '1 day' AS fin
), facturas_periodo AS MATERIALIZED (
 -- Cobros del periodo, excluyendo transferencias aun pendientes.
 SELECT f.idfactura, f.formapago, f.estado, f.interescobrado, f.swiva,
        f.swmulta, f.swcondonar, FALSE AS pendiente_corte
 FROM facturas f CROSS JOIN limites l
 WHERE f.fechacobro >= l.inicio AND f.fechacobro < l.fin
   AND (f.formapago IS DISTINCT FROM 4 OR f.estado IS DISTINCT FROM 3)
 UNION ALL
 -- Transferencias originadas en el periodo y pendientes al cierre.
 -- La efectivizacion posterior no las elimina del periodo original.
 SELECT f.idfactura, f.formapago, f.estado, f.interescobrado, f.swiva,
        f.swmulta, f.swcondonar, TRUE AS pendiente_corte
 FROM facturas f CROSS JOIN limites l
 WHERE f.formapago = 4
   AND f.fechatransferencia >= l.inicio AND f.fechatransferencia < l.fin
   AND (f.estado = 3 OR (f.estado = 1 AND f.fechacobro >= l.fin))
), importes AS (
 SELECT rf.idfactura_facturas,
 SUM(CASE
   WHEN f.swmulta IS TRUE AND rf.idrubro_rubros IN (6, 1011) THEN 0
   WHEN f.swcondonar IS TRUE AND rf.idrubro_rubros = 6 THEN 0
   WHEN (rf.cantidad * rf.valorunitario)::numeric < 0
     THEN FLOOR((rf.cantidad * rf.valorunitario)::numeric * 100) / 100
   ELSE CEIL((rf.cantidad * rf.valorunitario)::numeric * 100) / 100
 END) AS subtotal
 FROM facturas_periodo f
 JOIN rubroxfac rf ON rf.idfactura_facturas = f.idfactura
 WHERE rf.idrubro_rubros NOT IN (5, 165)
   AND (rf.estado IS NULL OR rf.estado <> 0)
 GROUP BY rf.idfactura_facturas
), clasificadas AS (
 SELECT f.formapago,
 (COALESCE(i.subtotal, 0) + COALESCE(f.interescobrado, 0)
   + COALESCE(ROUND(f.swiva::numeric, 2), 0))::numeric AS valor_factura,
 COALESCE(NULLIF(BTRIM(fc.descripcion), ''),
   CASE WHEN f.formapago IS NULL THEN 'SIN FORMA DE PAGO'
        ELSE 'FORMA DE PAGO ' || f.formapago::text END) AS forma,
 CASE WHEN f.pendiente_corte THEN 'NO EFECTIVIZADAS'
      WHEN f.formapago = 4 AND f.estado = 1 THEN 'EFECTIVIZADAS'
      WHEN f.formapago = 4 AND f.estado = 3 THEN 'NO EFECTIVIZADAS'
      WHEN f.formapago = 4 THEN 'OTROS ESTADOS'
      ELSE '' END AS clasificacion,
 CASE WHEN f.pendiente_corte THEN 2
      WHEN f.formapago = 4 AND f.estado = 1 THEN 1
      WHEN f.formapago = 4 AND f.estado = 3 THEN 2 ELSE 3 END AS orden
 FROM facturas_periodo f
 LEFT JOIN importes i ON i.idfactura_facturas = f.idfactura
 LEFT JOIN formacobro fc ON fc.idformacobro = f.formapago
)
 , resumen AS (
 SELECT formapago, forma, clasificacion, orden, COUNT(*) AS cantidad,
        SUM(valor_factura) AS valor_total
 FROM clasificadas
 GROUP BY formapago, forma, clasificacion, orden
), eventos AS MATERIALIZED (
 SELECT f.idfactura, f.fechaanulacion, f.fechaeliminacion
 FROM facturas f CROSS JOIN limites l
 WHERE (f.fechaanulacion >= l.inicio AND f.fechaanulacion < l.fin)
    OR (f.fechaeliminacion >= l.inicio AND f.fechaeliminacion < l.fin)
), refacturadas AS (
 SELECT DISTINCT e.idfactura
 FROM eventos e CROSS JOIN limites l
 JOIN lecturas anterior ON anterior.idfactura = e.idfactura
 JOIN emisionindividual ei ON ei.idlecturaanterior = anterior.idlectura
 JOIN lecturas nueva ON nueva.idlectura = ei.idlecturanueva
 WHERE e.fechaeliminacion >= l.inicio AND e.fechaeliminacion < l.fin
   AND nueva.idfactura IS NOT NULL AND nueva.idfactura <> e.idfactura
), estadisticas AS (
 SELECT COUNT(*) FILTER (WHERE e.fechaanulacion >= l.inicio AND e.fechaanulacion < l.fin) AS anuladas,
        COUNT(*) FILTER (WHERE e.fechaeliminacion >= l.inicio AND e.fechaeliminacion < l.fin) AS eliminadas,
        COUNT(r.idfactura) AS refacturadas
 FROM eventos e CROSS JOIN limites l
 LEFT JOIN refacturadas r ON r.idfactura = e.idfactura
)
SELECT r.formapago, r.forma, r.clasificacion, COALESCE(r.cantidad, 0) AS cantidad,
       COALESCE(r.valor_total, 0::numeric) AS valor_total,
       e.anuladas, e.eliminadas, e.refacturadas,
       (SELECT nomusu FROM usuarios WHERE idusuario = $P{idusuario}) AS usuarioimpresion
FROM estadisticas e LEFT JOIN resumen r ON TRUE
ORDER BY r.formapago NULLS LAST, r.orden]]>
	</queryString>
	<field name="anuladas" class="java.lang.Long"/>
	<field name="eliminadas" class="java.lang.Long"/>
	<field name="refacturadas" class="java.lang.Long"/>
	<field name="usuarioimpresion" class="java.lang.String"/>
	<field name="formapago" class="java.lang.Integer"/>
	<field name="forma" class="java.lang.String"/>
	<field name="clasificacion" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Long"/>
	<field name="valor_total" class="java.math.BigDecimal"/>
	<variable name="TotalFacturas" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
		<initialValueExpression><![CDATA[0L]]></initialValueExpression>
	</variable>
	<variable name="TotalValores" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{valor_total}]]></variableExpression>
		<initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="FechaHoraImpresion" class="java.util.Date" calculation="System">
        <initialValueExpression><![CDATA[new java.util.Date()]]></initialValueExpression>
    </variable>
