<summary><band height="56">
<textField isBlankWhenNull="true"><reportElement x="0" y="0" width="555" height="18"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["TOTAL COBRADO: efectivo, SPI estado 1, externa, tarjeta y cheque válidos."]]></textFieldExpression></textField>
<textField isBlankWhenNull="true"><reportElement x="0" y="18" width="555" height="18"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["NC y SPI estado 3 quedan separados. Porcentajes calculados por cantidad."]]></textFieldExpression></textField>
<textField isBlankWhenNull="true"><reportElement x="0" y="36" width="555" height="18"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Pendientes y antigüedad: solo facturas creadas en el período, estado actual."]]></textFieldExpression></textField>
</band></summary>
